*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Unity owns the YAML formatting of these generated files and emits meaningful
# empty scalar values with trailing spaces.
*.asset text eol=lf -whitespace
*.meta text eol=lf -whitespace
*.unity text eol=lf -whitespace
*.prefab text eol=lf -whitespace
*.anim text eol=lf -whitespace
*.controller text eol=lf -whitespace
*.overrideController text eol=lf -whitespace
*.mask text eol=lf -whitespace

# Personal DCC source and binary game assets. Install Git LFS on every workstation.
*.[mM][aA][xX] filter=lfs diff=lfs merge=lfs -text
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
